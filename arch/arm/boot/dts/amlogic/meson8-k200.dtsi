// SPDX-License-Identifier: GPL-2.0 OR MIT
/*
 * Copyright 2025 Gianluca
 *
 * Common device tree for Amlogic Meson8 K200 TV Box variants
 *
 * Hardware:
 * - SoC: Amlogic S802 (Meson8) quad-core Cortex-A9
 * - Storage: 8GB NAND (Hynix H27UCG8T2E) - NOT eMMC!
 * - WiFi: Broadcom BCM40181A2 (AP6330 module) on SDIO
 * - Bluetooth: Broadcom BCM40183 (AP6330 combo)
 * - Ethernet: 10/100 internal PHY (PHY ID 02430c54)
 * - PMIC: Ricoh RN5T618F
 *
 * Note: NAND storage requires vendor FTL driver not available in mainline.
 * This DTS is suitable for netboot/NFS root or SD card boot.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	aliases {
		serial0 = &uart_AO;
		mmc0 = &sd_card_slot;
		mmc1 = &sdhc;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio_ao GPIOAO_6 GPIO_ACTIVE_LOW>;
		clocks = <&wifi_32k>;
		clock-names = "ext_clock";
	};

	wifi_32k: wifi-32k {
		compatible = "pwm-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		pwms = <&pwm_ef 0 30518 0>; /* PWM_E at 32.768kHz */
	};

	gpio-keys {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;

		power-button {
			label = "Power";
			linux,code = <KEY_POWER>;
			gpios = <&gpio_ao GPIOAO_3 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-blue {
			label = "k200:blue:power";
			gpios = <&gpio_ao GPIO_TEST_N GPIO_ACTIVE_HIGH>;
			default-state = "on";
			linux,default-trigger = "default-on";
		};
	};

	usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "USB_VBUS";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio GPIOZ_1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vcc_3v3: regulator-vcc3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VCC3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	vcc_5v: regulator-vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "VCC5V";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	sound {
		compatible = "amlogic,gx-sound-card";
		model = "K200";
		assigned-clocks = <&clkc CLKID_MPLL0>,
				  <&clkc CLKID_MPLL1>;
		assigned-clock-rates = <294912000>,
				       <270950400>;
		status = "disabled"; /* Enable when audio codec is configured */

		dai-link-0 {
			sound-dai = <&aiu AIU_CPU CPU_I2S_FIFO>;
		};

		dai-link-1 {
			sound-dai = <&aiu AIU_CPU CPU_I2S_ENCODER>;
		};

		dai-link-2 {
			sound-dai = <&aiu AIU_HDMI CTRL_I2S>;
		};
	};
};

&aiu {
	status = "disabled"; /* Enable when audio is configured */
};

&ethmac {
	status = "okay";
	pinctrl-0 = <&eth_pins>;
	pinctrl-names = "default";
	phy-mode = "rmii";

	/* Internal PHY */
	snps,reset-gpio = <&gpio GPIOZ_14 GPIO_ACTIVE_LOW>;
	snps,reset-delays-us = <0 10000 1000000>;
	snps,reset-active-low;
};

&gpio {
	gpio-line-names =
		/* GPIOX bank */
		"WIFI_SD_D0", "WIFI_SD_D1", "WIFI_SD_D2", "WIFI_SD_D3",
		"I2S_SCLK", "I2S_LRCK", "I2S_DOUT", "I2S_DIN",
		"WIFI_SD_CLK", "WIFI_SD_CMD", "WIFI_32K", "WIFI_PWREN2",
		"UART_A_TX", "UART_A_RX", "UART_A_CTS", "UART_A_RTS",
		"", "", "", "",
		"BT_RST", "WIFI_IRQ",
		/* GPIOY bank */
		"DVB_D0", "DVB_D1", "", "SPDIF_OUT",
		"DVB_CLK", "DVB_RST", "", "",
		"DVB_VALID", "DVB_D2", "DVB_D3", "DVB_D4",
		"DVB_D5", "DVB_D6", "DVB_D7", "DVB_SYNC",
		"DVB_ERR",
		/* GPIODV bank */
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "",
		/* GPIOH bank */
		"HDMI_HPD", "HDMI_SDA", "HDMI_SCL", "",
		"", "", "", "", "", "",
		/* GPIOZ bank */
		"SD_WP", "USB_VBUS_EN", "I2C_B_SCK", "I2C_B_SDA",
		"", "", "", "", "", "",
		"", "", "", "", "ETH_RST",
		/* CARD bank */
		"SD_D1", "SD_D0", "SD_CLK", "SD_CMD",
		"SD_D3", "SD_D2", "SD_CD",
		/* BOOT bank - NAND Flash (Hynix H27UCG8T2E 8GB) */
		"NAND_D0", "NAND_D1", "NAND_D2", "NAND_D3",
		"NAND_D4", "NAND_D5", "NAND_D6", "NAND_D7",
		"NAND_CE0", "NAND_CE1", "NAND_RB0",
		"NOR_D", "NOR_Q", "NOR_C",
		"", "NAND_DQS", "NAND_RE_WR", "NAND_ALE_CLE",
		"NOR_CS";
};

&gpio_ao {
	gpio-line-names =
		"UART_AO_TX", "UART_AO_RX", "", "PWR_BTN",
		"I2C_AO_SCK", "I2C_AO_SDA", "WIFI_PWREN", "IR_IN",
		"I2S_AO_SCLK", "I2S_AO_LRCK", "I2S_AO_DOUT", "I2S_AO_DIN",
		"", "", "GPIO_BSD_EN", "LED_BLUE";
};

&i2c_AO {
	status = "okay";
	pinctrl-0 = <&i2c_ao_pins>;
	pinctrl-names = "default";

	pmic@32 {
		compatible = "ricoh,rn5t618";
		reg = <0x32>;
		system-power-controller;

		regulators {
			vcck: DCDC1 {
				regulator-name = "VCCK";
				regulator-min-microvolt = <825000>;
				regulator-max-microvolt = <1150000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vddee: DCDC2 {
				regulator-name = "VDDEE";
				regulator-min-microvolt = <950000>;
				regulator-max-microvolt = <1150000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vddao: DCDC3 {
				regulator-name = "VDDAO";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ddr: DCDC4 {
				regulator-name = "DDR";
				regulator-min-microvolt = <1500000>;
				regulator-max-microvolt = <1500000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vcc_1v8: LDO1 {
				regulator-name = "VCC1V8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vcc_3v3_ao: LDO2 {
				regulator-name = "VCC3V3_AO";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vcc_1v0: LDO3 {
				regulator-name = "VCC1V0";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo4: LDO4 {
				regulator-name = "LDO4";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			ldo5: LDO5 {
				regulator-name = "LDO5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};
		};
	};
};

&i2c_B {
	status = "okay";
	pinctrl-0 = <&i2c_b_pins>;
	pinctrl-names = "default";

	/*
	 * DVB demodulator: AVL6211
	 * The AVL6211 is not supported in mainline.
	 * I2C address: 0x60 (7-bit)
	 */
};

&ir_receiver {
	status = "okay";
	pinctrl-0 = <&ir_recv_pins>;
	pinctrl-names = "default";
};

&pwm_ef {
	status = "okay";
	pinctrl-0 = <&pwm_e_pins>;
	pinctrl-names = "default";
};

&rtc {
	status = "okay";
};

&saradc {
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

/*
 * Note: This device has 8GB NAND (Hynix H27UCG8T2E) instead of eMMC.
 * The NAND uses a vendor-specific FTL not supported in mainline.
 * Boot from SD card or network is required for mainline.
 */

/*
 * SDIO WiFi: Broadcom BCM40181A2 (AP6330 module)
 * Uses the SDHC controller with SDXC_A pins
 */
&sdhc {
	status = "okay";

	pinctrl-0 = <&sdxc_a_pins>;
	pinctrl-names = "default";

	bus-width = <4>;
	max-frequency = <50000000>;

	disable-wp;
	non-removable;
	cap-mmc-highspeed;
	cap-sd-highspeed;

	mmc-pwrseq = <&sdio_pwrseq>;

	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&vcc_3v3>;
};

/* SD card slot */
&sdio {
	status = "okay";

	pinctrl-0 = <&sd_b_pins>;
	pinctrl-names = "default";

	sd_card_slot: slot@1 {
		compatible = "mmc-slot";
		reg = <1>;
		status = "okay";

		bus-width = <4>;
		no-sdio;
		cap-mmc-highspeed;
		cap-sd-highspeed;
		disable-wp;

		cd-gpios = <&gpio CARD_6 GPIO_ACTIVE_LOW>;

		vmmc-supply = <&vcc_3v3>;
	};
};

&spifc {
	status = "okay";
	pinctrl-0 = <&spi_nor_pins>;
	pinctrl-names = "default";

	flash@0 {
		compatible = "jedec,spi-nor";
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0>;
		spi-max-frequency = <30000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootloader";
				reg = <0x0 0x100000>;
				read-only;
			};

			partition@100000 {
				label = "env";
				reg = <0x100000 0x10000>;
			};
		};
	};
};

&uart_A {
	status = "okay";
	pinctrl-0 = <&uart_a1_pins>, <&uart_a1_cts_rts_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;

	/* Bluetooth: BCM40183 (AP6330 combo module) */
	bluetooth {
		compatible = "brcm,bcm4330-bt";
		shutdown-gpios = <&gpio GPIOX_20 GPIO_ACTIVE_HIGH>;
		max-speed = <2000000>;
		clocks = <&wifi_32k>;
		clock-names = "lpo";
	};
};

&uart_AO {
	status = "okay";
	pinctrl-0 = <&uart_ao_a_pins>;
	pinctrl-names = "default";
};

&usb0 {
	status = "okay";
	dr_mode = "otg";
};

&usb0_phy {
	status = "okay";
};

&usb1 {
	status = "okay";
	vbus-supply = <&usb_vbus>;
};

&usb1_phy {
	status = "okay";
};
